# Ignore all source code and dev files (public distribution only)
node_modules/
build/
bin/
desktop/
src/
test/
scripts/
package.json
package-lock.json
tsconfig.json

# Dist folder: archive old releases and expose only the latest release
dist/*
!dist/old/
!dist/latest/
dist/old/*
dist/latest/*
!dist/old/*.exe
!dist/latest/*.exe

data/
downloads/
inputs/
release/
distribution/
distribution-*/
final-package/
package-output/
*.log

# Local license administration and production endpoint
DANH_SACH_KEY_BAN_QUYEN.md
license-config*.json
license-server/

# Browser profiles, credentials and generated media
**/profiles/
**/chrome-profile/
**/*.secure.json
*.mp4
*.webm
