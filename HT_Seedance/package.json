{
  "name": "ht-dola-studio-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "HT_Dola_Studio - Local Windows desktop production manager for video generation workflows",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "dev:desktop": "pnpm --filter @ht-dola/desktop dev",
    "dev:service": "pnpm --filter @ht-dola/automation-service dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "test": "pnpm --recursive run test",
    "test:performance": "pnpm --filter @ht-dola/automation-service test:performance",
    "test:soak": "node scripts/run-soak.mjs",
    "prepare:windows-sidecar": "node scripts/prepare-windows-sidecar.mjs",
    "build:windows": "pnpm --filter @ht-dola/desktop tauri build",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:migrate": "pnpm --filter @ht-dola/automation-service db:migrate",
    "db:seed": "pnpm --filter @ht-dola/automation-service db:seed",
    "db:status": "pnpm --filter @ht-dola/automation-service db:status",
    "backup:create": "pnpm --filter @ht-dola/automation-service backup:create",
    "backup:verify": "pnpm --filter @ht-dola/automation-service backup:verify",
    "restore:verify": "pnpm --filter @ht-dola/automation-service restore:verify"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
